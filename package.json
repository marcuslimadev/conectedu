{
  "name": "conectedu-frontend",
  "version": "1.0.0",
  "description": "Sistema de AEE ConectEDU - Frontend",
  "main": "index.js",
  "scripts": {
    "build-css": "tailwindcss -i ./frontend/tailwind-src.css -o ./frontend/tailwind-local.css --watch",
    "build-css-prod": "tailwindcss -i ./frontend/tailwind-src.css -o ./frontend/tailwind-local.css --minify",
    "dev": "npm run build-css",
    "build": "npm run build-css-prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "http-server": "^14.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "aee",
    "educacao",
    "inclusao",
    "vue",
    "tailwind"
  ],
  "author": "Sistema ConectEDU",
  "license": "MIT"
}
