{
  "name": "conectedu-frontend",
  "version": "5.0.1",
  "description": "Sistema de AEE ConectEDU - Frontend com Testes",
  "main": "index.js",
  "scripts": {
    "build-css": "tailwindcss -i ./frontend/tailwind-src.css -o ./frontend/tailwind-local.css --watch",
    "build-css-prod": "tailwindcss -i ./frontend/tailwind-src.css -o ./frontend/tailwind-local.css --minify",
    "dev": "npm run build-css",
    "build": "npm run build-css-prod",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:pdf": "playwright test tests/pdf-generation.spec.js",
    "test:forms": "playwright test tests/forms-validation.spec.js",
    "test:entrevista": "playwright test tests/entrevista-form.spec.js",
    "test:pdi": "playwright test tests/pdi-form.spec.js",
    "test:pai": "playwright test tests/pai-form.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "pdf-parse": "^1.1.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "aee",
    "educacao",
    "inclusao",
    "vue",
    "tailwind",
    "playwright"
  ],
  "author": "Sistema ConectEDU",
  "license": "MIT"
}
